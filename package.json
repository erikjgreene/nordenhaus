{
  "name": "nordenhaus-data-extractor",
  "version": "1.0.0",
  "description": "Direct Airbnb listing and reviews scraper (no images, no Apify required) for Norden Haus website build",
  "type": "module",
  "main": "scripts/scrape_airbnb_direct.js",
  "scripts": {
    "dev": "python3 -m http.server 3000",
